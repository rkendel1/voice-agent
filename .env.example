# Production settings for Voice Agent. Copy to .env.local (never commit it) and fill in.
# Development needs none of these.

# 32+ random bytes, the same on every process: openssl rand -base64 32
FELTKIT_AUTH_SECRET=
# The https URL people open the app at.
FELTKIT_PUBLIC_URL=https://voice.example.com
# Account e-mail (sign-in links, invitations) through Mailerport.
MAILPORT_URL=
MAILPORT_API_KEY=
# Production Studio for operators (`npx feltkit manage`).
# FELTKIT_DASHBOARD=1
# FELTKIT_OPERATOR_KEY=

# One port serves everything: people, Studio, AppPort, and the voice component's /twilio/* routes.
PORT=3000

# Telephony is configured in Studio → Services → Configuration (TELEPHONY_PROVIDER, TWILIO_ACCOUNT_SID,
# PUBLIC_BASE_URL) and Credentials (twilio-auth-token). Where a host can only take environment variables,
# FeltKit's custody also reads a credential from FELTKIT_CREDENTIAL_<ID>:
# FELTKIT_CREDENTIAL_TWILIO_AUTH_TOKEN=
# PUBLIC_BASE_URL is also read from the environment when Configuration does not set it:
# PUBLIC_BASE_URL=https://voice.example.com

# The development simulator is off in production; enable only for a staging demo:
# SIMULATOR_ENABLED=1
